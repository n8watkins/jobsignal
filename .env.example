# Web app
DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SINGLE_USER_EMAIL="nathancwatkins23@gmail.com"

# Token encryption — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=""

# AI provider — wire GEMINI_API_KEY first (used for company research)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Set to "true" to enable Gemini web-search grounding (spends search budget)
AI_SEARCH_ENABLED=false

# Google/Gmail OAuth — create credentials in Google Cloud Console
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Chrome extension calls this — must match the secret stored in extension settings
EXTENSION_SHARED_SECRET="dev-extension-secret-change-me"
