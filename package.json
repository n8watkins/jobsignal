{
  "name": "jobsignal-starter",
  "private": true,
  "version": "0.1.0",
  "description": "JobSignal V1 personal job-search command center starter repo.",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "setup:env": "cp .env.example apps/web/.env",
    "dev": "pnpm --filter @jobsignal/web dev",
    "build": "pnpm --filter @jobsignal/web build",
    "lint": "pnpm --filter @jobsignal/web lint",
    "db:generate": "pnpm --filter @jobsignal/web prisma:generate",
    "db:migrate": "pnpm --filter @jobsignal/web prisma:migrate",
    "extension:build": "pnpm --filter @jobsignal/extension build",
    "typecheck": "pnpm -r typecheck"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
